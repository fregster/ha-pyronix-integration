# Pyronix Cloud probe settings. Copy to .env and fill in. NEVER commit .env.
# See PROTOCOL.md §2 for what each value means.

# Cloud relay endpoint (live). Test endpoint: wss://apptestlb.pyronixcloud.com:443
PYRONIX_CLOUD_URL=wss://app.pyronixcloud.com:443

# AppUser: the app's "Device name" (HomeControl2 > Settings > User Name). Free text, at least
# 3 characters; it defaults to the phone model. NOT your e-mail. Any stable name should work.
# The Pyronix Cloud portal lists clients by this name. Use a NEW name (e.g. "Home Assistant"),
# never your phone's. Reusing it may overwrite the phone's push registration. The new device may
# need "Access Allowed" in the portal. Quote names with spaces/apostrophes; avoid & and < (no XML escaping).
PYRONIX_APP_USER=

# The "System ID" entered when the panel was added (8 characters, upper case, no 0 or 1).
# The app shows it as "Panel ID:".
PYRONIX_PANEL_ID=

# The "App password" the HomeControl2 login screen asks for (not the keypad code).
# Set on the panel by the installer. Keys the encryption.
PYRONIX_PANEL_PASSWORD=

# The "User code" the HomeControl2 login screen asks for (your keypad code).
# Sent after the encrypted session is up.
PYRONIX_USER_CODE=

# Friendly name for the panel (probably cosmetic).
PYRONIX_SYSTEM_NAME=Home

# Stable device identifier. Any non-empty value; leave blank to have the probe generate one.
PYRONIX_DEVICE_ID=

# Push token. Must be non-empty; whether the cloud validates it is unknown (§13 Q1).
PYRONIX_PUSH_ID=ha-pyronix-probe
